# Leave all unset for the fixture-only preview.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. Both are required to offer Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for email registration, password recovery and email changes.
# Use an smtps:// URL for implicit TLS or smtp:// with mandatory STARTTLS.
SMTP_URL=
SMTP_FROM=

# Optional browser Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Separate restricted PostgreSQL login for the background push worker.
PUSH_DATABASE_URL=
